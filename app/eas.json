{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "internal",
      "channel": "production",
      "environment": "production",
      "ios": {
        "simulator": false
      }
    },
    // NOTE: reads the "preview" EAS environment, not a "stage" one. Custom
    // environment names require a Production/Enterprise plan; only production,
    // preview and development exist. "preview" holds the stage API URL.
    "stage": {
      "distribution": "internal",
      "channel": "stage",
      "environment": "preview",
      "ios": {
        "simulator": false
      }
    }
  }
}
